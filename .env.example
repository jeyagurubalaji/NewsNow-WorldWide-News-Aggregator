# 1. FRONTEND ENVIRONMENT VARIABLES (Vite Client)

# Base API URL where the React app sends requests
VITE_API_URL=http://localhost:8080/api

# Google OAuth Client ID for frontend Google Sign-In button
VITE_GOOGLE_CLIENT_ID=my-google-client-id.apps.googleusercontent.com

# 2. BACKEND SERVER CONFIGURATION

PORT=8080

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 3. DATABASE CONFIGURATION (MongoDB Atlas)

# MongoDB connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority


# 4. JWT (JSON WEB TOKEN) AUTHENTICATION
# Secret key used to sign and verify JSON Web Tokens
JWT_SECRET=my-secure-random-jwt-secret-key

# Token expiration time in milliseconds (e.g., 86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000


# 5. GOOGLE OAUTH CREDENTIALS (Backend Verification)

GOOGLE_CLIENT_ID=my-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=my-google-client-secret


# 6. SMTP / EMAIL SERVICE CONFIGURATION (Nodemailer - OTPs & Emails)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=my-email@gmail.com
SMTP_PASS=my-16-character-app-password


# 7. NEWS AGGREGATOR & SCHEDULER SETTINGS

GOOGLE_NEWS_RSS_BASE_URL=https://news.google.com/rss

# Background news refresh scheduler interval in milliseconds (300000 = 5 mins)
NEWS_REFRESH_INTERVAL_MS=300000
NEWS_REFRESH_CONCURRENCY=50
NEWS_REFRESH_SOFT_CAP_MS=3000

# Cache TTL and fallback API parameters
NEWS_SCHEDULER_API_DELAY_MS=250
NEWSAPI_FALLBACK_ENABLED=true
NEWS_CACHE_TTL_MINUTES=5